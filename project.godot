; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="紫水鸡棋盘 · UI树开发"
config/version="0.1.3a"
run/main_scene="res://scenes/application.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="紫水鸡棋盘"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Mobile="*res://scripts/mobile_layout.gd"
TokenPreviews="*res://scripts/token_thumbnail_cache.gd"
ProductCatalog="*res://scripts/product_catalog.gd"

Storage="*res://scripts/storage_bootstrap.gd"
Interface="*res://scripts/interface_settings.gd"
Graphics="*res://scripts/graphics_settings.gd"
Updates="*res://scripts/software_updates.gd"

[debug]

file_logging/log_path="logs/godot.log"
file_logging/log_path.android="user://logs/godot.log"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor_plugins]

enabled=PackedStringArray("res://addons/dev_workflow/plugin.cfg")

[rendering]

renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

rendering_device/fallback_to_opengl3=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.055, 0.065, 0.085, 1)
