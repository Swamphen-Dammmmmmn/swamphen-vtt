[gd_scene load_steps=4 format=3]
[ext_resource type="Theme" path="res://ui/theme/modern.tres" id="1"]
[ext_resource type="Script" path="res://ui/components/token_name.gd" id="2"]

[sub_resource type="SystemFont" id="NameFont"]
