[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/components/route_card.gd" id="1"]
[ext_resource type="Theme" path="res://ui/theme/modern.tres" id="2"]

[node name="RouteCard" type="PanelContainer"]
theme = ExtResource("2")
script = ExtResource("1")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Summary" type="Label" parent="Content"]
layout_mode = 2
text = "已固定 · 0 英尺"
theme_override_font_sizes/font_size = 18

[node name="Hint" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 13
text = "点击棋盘添加路径点"

[node name="Buttons" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Undo" type="Button" parent="Content/Buttons"]
layout_mode = 2
focus_mode = 0
text = "撤销一点"
tooltip_text = "删除最近添加的路径点 · Ctrl+Z / Backspace"

[node name="Confirm" type="Button" parent="Content/Buttons"]
layout_mode = 2
focus_mode = 0
theme_type_variation = &"PrimaryButton"
text = "确认"
tooltip_text = "移动到最后一个固定点 · Enter"

[node name="Cancel" type="Button" parent="Content/Buttons"]
layout_mode = 2
focus_mode = 0
text = "取消"
tooltip_text = "取消整条路线"
